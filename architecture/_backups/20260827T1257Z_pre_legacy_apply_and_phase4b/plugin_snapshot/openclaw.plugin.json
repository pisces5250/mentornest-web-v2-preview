  "configSchema": {
    "type": "object",
    "additionalProperties": false
  },
  "manifest": {
    "tools": [
      {
        "name": "tts_synthesize",
        "description": "Synthesize speech for the given text using local TTS only (sherpa-onnx-tts priority). Falls back to a deterministic placeholder WAV (440 Hz sine, mono 16 kHz 16-bit PCM) when the sherpa runtime + model are unavailable. Cloud TTS providers are FORBIDDEN. Returns {ok, audio_b64, audio_format, duration_ms, voice_id, content_hash, backend} on success.",
        "parameters": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "voice_id": {
              "type": "string",
              "minLength": 1
            },
            "speed": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 2
            }
          },
          "required": [
            "text"
          ]
        },
        "handler": "ttsSynthesize"
      },
      {
        "name": "tts_list_voices",
        "description": "List available local TTS voices (voice_id, locale, gender, sample_rate_hz, description). Deterministic.",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": []
        },
        "handler": "ttsListVoices"
      },
      {
        "name": "tts_status",
        "description": "Report local TTS backend status: {backend: 'sherpa-onnx-tts' | 'placeholder', available, reason}. Cloud TTS providers are never reported as available.",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": []
        },
        "handler": "ttsStatus"
      },
      {
        "name": "tts_hash_text",
        "description": "Compute a deterministic content hash (first 16 hex chars of sha256) over (text, voice_id, speed). Useful for cache-key testing.",
        "parameters": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "voice_id": {
              "type": "string",
              "minLength": 1
            },
            "speed": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 2
            }
          },
          "required": [
            "text"
          ]
        },
        "handler": "ttsComputeContentHash"
      },
      {
        "name": "school_progress_inferred_status",
        "description": "Read-only view of inferred / stale / confirmed record counts for one student. Returns {ok, student_id, total_inferred, total_stale, total_confirmed, ttl_days, ttl_source, last_sweep_at, path}.",
        "parameters": {
          "type": "object",
          "properties": {
            "student_id": {
              "type": "string",
              "pattern": "^student_[A-Za-z0-9_-]+$"
            }
          },
          "required": [
            "student_id"
          ]
        },
        "handler": "schoolProgressInferredStatus"
      },
      {
        "name": "school_progress_inferred_mark_stale",
        "description": "Sweep one student's school_progress: mark inferred records whose age >= ttl_days as stale. Idempotent. Stale records remain on disk; only their status field changes inferred → stale. NEVER auto-promotes to confirmed.",
        "parameters": {
          "type": "object",
          "properties": {
            "student_id": {
              "type": "string",
              "pattern": "^student_[A-Za-z0-9_-]+$"
            },
            "now_ms": {
              "type": "number"
            }
          },
          "required": [
            "student_id"
          ]
        },
        "handler": "schoolProgressInferredMarkStale"
      },
      {
        "name": "school_progress_inferred_promote",
        "description": "Explicit human promotion: convert one specific inferred or stale record to confirmed. Requires confirmed_by (e.g. parent_setup, manual). Refuses already-confirmed. NEVER auto-promotes; only this explicit tool may promote.",
        "parameters": {
          "type": "object",
          "properties": {
            "student_id": {
              "type": "string",
              "pattern": "^student_[A-Za-z0-9_-]+$"
            },
            "knowledge_point": {
              "type": "string",
              "minLength": 1
            },
            "confirmed_by": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "student_id",
            "knowledge_point",
            "confirmed_by"
          ]
        },
        "handler": "schoolProgressInferredPromote"
      },
      {
        "name": "school_progress_inferred_ttl_sweep",
        "description": "Sweep one OR all students: mark inferred records stale per TTL. Returns {ok, swept_students, total_newly_stale, swept_at}. Idempotent across repeated calls.",
        "parameters": {
          "type": "object",
          "properties": {
            "student_id": {
              "type": "string",
              "pattern": "^student_[A-Za-z0-9_-]+$"
            }
          }
        },
        "handler": "schoolProgressInferredTtlSweep"
      },
      {
        "name": "raw_question_ingest",
        "description": "Phase 4A — Ingest raw content (text/structured/pdf/image) into RawCandidate[]. PDF and image binary inputs return an unsupported_in_round_4a error (no cloud OCR installed). Pure: does NOT write to disk and does NOT promote anything to the verified bank.",
        "parameters": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["text", "structured", "pdf", "image"]
            },
            "content": {
              "type": ["string", "object", "array"]
            },
            "source_class": {
              "type": "string",
              "enum": ["student_private", "ai_authored", "open_license", "teacher_authored"]
            },
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "enum": ["AI_ORIGINAL", "AI_ADAPTED", "CC-BY", "CC-BY-SA", "CC0", "PRIVATE"]
            }
          }
        },
        "handler": "rawQuestionIngest"
      },
      {
        "name": "raw_question_segment",
        "description": "Phase 4A — Segment an array of RawCandidate into SegmentedQuestion[]. Pure: does NOT write to disk. Recognizes short_answer / multiple_choice / true_false / fill_in_blank / essay / unknown.",
        "parameters": {
          "type": "object",
          "properties": {
            "candidates": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "handler": "rawQuestionSegment"
      }
    ]
  },
