FROM node:22-alpine

ENV NODE_ENV=production \
    PORT=8787

WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY server ./server
COPY src/tutor ./src/tutor
COPY src/foundation ./src/foundation

USER node
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8787/api/health || exit 1
CMD ["node", "server/open-response.mjs"]
