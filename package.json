{
  "name": "mentornest-web-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,backend -c blue,green \"vite\" \"node server/open-response.mjs\"",
    "dev:vite": "vite",
    "dev:backend": "node server/open-response.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "verify": "npm test && npm run build",
    "verify:full": "npm run typecheck && npm run verify && npm run test:browser",
    "preview": "vite preview",
    "test": "node --test $(find test -name '*.test.mjs' -type f | sort)",
    "test:browser": "npm run build && node test/a11y/run-react-browser-gate.mjs",
    "test:staging-runtime": "node test/staging/runtime-evidence-smoke.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "axe-core": "^4.13.0",
    "concurrently": "^10.0.5",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  }
}
