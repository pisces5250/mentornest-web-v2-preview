# 僅為變數名稱範本，不得提交真實 secret 或 production service ID。
MENTORNEST_ENV=staging
STAGING_WEB_BIND_ADDRESS=127.0.0.1
STAGING_WEB_PORT=8080
STAGING_DEPLOYMENT_ID=replace-with-staging-deployment-id
PRODUCTION_FALLBACK_SERVICE_ID=6a8eaa6e7d3d98c91024fb26
PRODUCTION_OPENCLAW_SERVICE_ID=6a8e84ce9ec391c39ae7a996
STAGING_DATA_NAMESPACE=mentornest-staging-isolated
WEB_EDGE_IMAGE=ghcr.io/example/mentornest-web@sha256:replace-with-verified-digest
TUTOR_BACKEND_IMAGE=ghcr.io/example/mentornest-tutor@sha256:replace-with-verified-digest
VOICE_BACKEND_IMAGE=registry.example/mentornest-voice@sha256:replace-with-verified-digest
OPENCLAW_LEARNING_IMAGE=registry.example/mentornest-openclaw@sha256:replace-with-verified-digest
OPENCLAW_RUNTIME_VERSION=replace-with-verified-runtime-version
MENTORNEST_GATEWAY_SESSION_SECRET=inject-from-secret-store
MENTORNEST_SERVICE_AUTH_KEY=inject-from-secret-store
OPENCLAW_SERVICE_AUTH_KEY=inject-from-secret-store
STAGING_OPENCLAW_VOLUME_NAME=mentornest-openclaw-p09-staging-only
STAGING_EDGE_NETWORK_NAME=mentornest-p011-staging-edge
STAGING_PRIVATE_NETWORK_NAME=mentornest-p011-staging-private
OPENCLAW_CAPABILITY_CONTRACT_VERSION=1
